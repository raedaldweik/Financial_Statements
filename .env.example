# Full ingestion mode (statement transcription, note curation, investor lens) needs a key.
# Without it the server runs in extraction-only mode.
ANTHROPIC_API_KEY=

# Optional
MODEL=claude-opus-5-5          # statements, auditor facts, analyst brief, investor lens
MODEL_NOTES=claude-opus-5-5    # per-note curation batches (claude-sonnet-5-5 for faster, cheaper runs)
LLM_EFFORT=medium              # low | medium | high | xhigh | max
NOTES_PER_CALL=6
PARALLEL_NOTE_CALLS=3
MAX_UPLOAD_MB=40
STORAGE_DIR=./storage
