# ═══════════════════════════════════════════════════════════════════
# Fraud Complaint Analyzer — environment variables
# On Railway, set these under the service's Variables tab.
# ═══════════════════════════════════════════════════════════════════

# ─── LLM (the only variable you really need) ───────────────────────
# Without it the app still boots and runs the built-in recorded analysis.
# With it you get live agents (and the recorded analysis as an automatic
# fallback if a live run fails for any reason).
ANTHROPIC_API_KEY=sk-ant-...

# ─── Optional tuning (defaults shown) ──────────────────────────────
#MODEL=claude-opus-5            # or claude-sonnet-5 for snappier demo turns
#LLM_EFFORT=medium              # low | medium | high | xhigh | max
#MAX_TOKENS=8192                # per intermediate agent turn
#REPORT_MAX_TOKENS=16000        # final structured report
#MAX_TOOL_ROUNDS=8              # tool-call rounds per agent before forcing the memo
#DEFAULT_MODE=auto              # auto | live | replay (auto = live when key set)

# ─── Arabic ────────────────────────────────────────────────────────
#PREWARM_TRANSLATIONS=1         # 0 = do not translate the seeded case files at startup

# ─── Clock ─────────────────────────────────────────────────────────
#DEMO_TZ=Asia/Dubai             # timezone for filing timestamps / "today"
#DEMO_TODAY=2026-09-10          # pin the date for a rehearsal (normally unset)
